		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;IL2026;IL2075;IL3000;WFO0003;CS4014;CS0618;CS0169;CS0414;CS0108;MVVMTK0034;CS8619;CS8620;CS8765;CS0114;CS8609;CS8610;CS0105;FodyPackageReference;CS1591;IL2091;IL2046;IL2072;IL2070;CS8669;CS0168;CS0162;CS1573;CS1723;CS1734;CS1572;CS0109;RS2000;RS1041;RS1036;CS1570;CS0436;RS1031;RS1032;SYSLIB0014;CS8714;MSB3277</NoWarn>
