<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             x:Class="Skua.App.Avalonia.UserControls.JumpUserControl"
             x:DataType="vms:JumpViewModel">
  <Border Background="{DynamicResource SkuaSurfaceBrush}"
          BorderBrush="{DynamicResource SkuaBorderBrush}"
          BorderThickness="1"
          Padding="12"
          CornerRadius="8"
          MinWidth="320"
          Width="320">
    <StackPanel Spacing="10">
      
      <!-- Top Title -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="RunFast" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Fast Map Jump" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

      <!-- Select Cell & Pad -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <ComboBox x:Name="Cells"
                  Grid.Column="0"
                  Height="34"
                  MinWidth="140"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Cell..."
                  ItemsSource="{Binding Cells}"
                  SelectedItem="{Binding SelectedCell}" />

        <ComboBox x:Name="Pads"
                  Grid.Column="1"
                  Height="34"
                  MinWidth="140"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select Pad..."
                  ItemsSource="{Binding Pads}"
                  SelectedItem="{Binding SelectedPad}" />
      </Grid>


      <!-- Action Buttons -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Grid.Column="0"
                Classes="skua-button"
                Height="34"
                HorizontalAlignment="Stretch"
                Command="{Binding GetCurrentCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="MapMarkerOutline" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="Current" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1"
                Classes="skua-button skua-primary"
                Height="34"
                HorizontalAlignment="Stretch"
                Command="{Binding JumpToCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="RunFast" Width="15" Height="15" VerticalAlignment="Center" />
            <TextBlock Text="Jump" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
