<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:controls="clr-namespace:Skua.App.Avalonia.Controls"
        x:Class="Skua.App.Avalonia.Views.TabbedHostWindow"
        Classes="skua"
        Title="VibeSkua" Icon="avares://Skua.Shared.Avalonia/Assets/SkuaClientIcon.ico" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SkuaPageBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">
    <Grid RowDefinitions="32,Auto,*">
        <sharedShell:WindowTitleBar x:Name="MainTitleBar" Grid.Row="0" TitleText="VibeSkua" />

        <!-- Top Tab Bar & Army Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid ColumnDefinitions="*,Auto,Auto">
                
                <!-- Client Tabs Bar with Left/Right Scroll Indicators -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                    <!-- Scroll Tabs Left Button -->
                    <Button x:Name="ScrollTabsLeftButton"
                            Grid.Column="0"
                            Click="ScrollTabsLeftButton_Click"
                            Width="20"
                            Height="28"
                            VerticalAlignment="Center"
                            Margin="2,0,1,0"
                            Padding="0"
                            Classes="skua-button"
                            CornerRadius="4"
                            Cursor="Hand"
                            IsVisible="False"
                            ToolTip.Tip="Scroll tabs left (more tabs hidden)">
                        <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                    </Button>

                    <!-- Client Tabs -->
                    <ScrollViewer x:Name="TabScrollViewer"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <TabControl x:Name="InstancesTabControl"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="4,0,0,0"
                                    SelectionChanged="InstancesTabControl_SelectionChanged">
                            <TabControl.Styles>
                                <Style Selector="TabItem">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="MinWidth" Value="60" />
                                    <Setter Property="MaxWidth" Value="180" />
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
                                    <Setter Property="Margin" Value="0,4,3,0" />
                                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                    <Setter Property="CornerRadius" Value="6,6,0,0" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                                    <Setter Property="CornerRadius" Value="6,6,0,0" />
                                </Style>
                                <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
                                </Style>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                </Style>
                                <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                                    <Setter Property="BorderThickness" Value="1,2,1,0" />
                                    <Setter Property="CornerRadius" Value="6,6,0,0" />
                                </Style>
                                <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                </Style>
                                <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                                <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                </Style>
                                <Style Selector="TabControl /template/ Rectangle#PART_Separator">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                            </TabControl.Styles>
                            <TabControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </TabControl.ItemsPanel>
                        </TabControl>
                    </ScrollViewer>

                    <!-- Scroll Tabs Right Button -->
                    <Button x:Name="ScrollTabsRightButton"
                            Grid.Column="2"
                            Click="ScrollTabsRightButton_Click"
                            Width="20"
                            Height="28"
                            VerticalAlignment="Center"
                            Margin="1,0,2,0"
                            Padding="0"
                            Classes="skua-button"
                            CornerRadius="4"
                            Cursor="Hand"
                            IsVisible="False"
                            ToolTip.Tip="Scroll tabs right (more tabs hidden)">
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                    </Button>
                </Grid>

                <!-- New Tab & Quick Manager Account Launch -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0"
                            Spacing="3">
                    <Button x:Name="AddTabButton"
                            Click="AddTabButton_Click"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Padding="0"
                            Classes="skua-button"
                            CornerRadius="6"
                            Cursor="Hand"
                            ToolTip.Tip="Open New Client Tab">
                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource SkuaAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <ToggleButton x:Name="AccountLaunchToggle"
                                  Width="24"
                                  Height="28"
                                  VerticalAlignment="Center"
                                  Padding="0"
                                  Classes="skua-button"
                                  CornerRadius="6"
                                  Cursor="Hand"
                                  Click="AccountLaunchToggle_Click"
                                  ToolTip.Tip="Launch saved Manager accounts">
                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="13" Height="13" Foreground="{DynamicResource SkuaTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ToggleButton>
                    <Popup x:Name="AccountQuickLaunchPopup"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           IsOpen="{Binding IsChecked, ElementName=AccountLaunchToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=AccountLaunchToggle}">
                        <Border Width="340"
                                Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="9">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Quick Account Launch"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SkuaTextBrush}" />
                                    <TextBlock x:Name="AccountQuickLaunchCountText"
                                               Text="Loading saved accounts..."
                                               FontSize="10"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                </StackPanel>
                                <TextBox x:Name="AccountQuickLaunchSearch"
                                         Height="34"
                                         TextChanged="AccountQuickLaunchSearch_TextChanged" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                    <ComboBox x:Name="AccountQuickLaunchGroupCombo"
                                              Grid.Column="0"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Choose a saved account group" />
                                    <Button x:Name="AccountQuickLaunchGroupButton"
                                            Grid.Column="1"
                                            Height="32"
                                            Padding="8,0"
                                            Classes="skua-button"
                                            Content="Launch Group"
                                            IsEnabled="False"
                                            Click="AccountQuickLaunchGroupLaunch_Click" />
                                    <Button x:Name="AccountQuickLaunchGroupNewWindowButton"
                                            Grid.Column="2"
                                            Height="32"
                                            Padding="8,0"
                                            Classes="skua-button"
                                            Content="New Window"
                                            IsEnabled="False"
                                            ToolTip.Tip="Launch this group in a separate VibeSkua window"
                                            Click="AccountQuickLaunchGroupNewWindow_Click" />
                                </Grid>
                                <Border x:Name="AccountQuickLaunchProgressPanel"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        IsVisible="False">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="AccountQuickLaunchProgressText"
                                                       Grid.Column="0"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MinWidth="0"
                                                       Foreground="{DynamicResource SkuaTextBrush}"
                                                       Text="Ready" />
                                            <Button x:Name="AccountQuickLaunchRetryButton"
                                                    Grid.Column="1"
                                                    Height="24"
                                                    Padding="7,0"
                                                    Classes="skua-button"
                                                    Content="Retry Failed"
                                                    IsVisible="False"
                                                    Click="AccountQuickLaunchRetry_Click" />
                                        </Grid>
                                        <ProgressBar x:Name="AccountQuickLaunchProgressBar"
                                                     Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="5">
                                    <TextBlock x:Name="AccountQuickLaunchSelectionText"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                                               Text="0 selected" />
                                    <Button Grid.Column="1"
                                            Height="26"
                                            Padding="7,0"
                                            Classes="skua-button"
                                            Content="Select All"
                                            Click="AccountQuickLaunchSelectAll_Click" />
                                    <Button Grid.Column="2"
                                            Height="26"
                                            Padding="7,0"
                                            Classes="skua-button"
                                            Content="Clear"
                                            Click="AccountQuickLaunchClear_Click" />
                                </Grid>
                                <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <Grid MinHeight="72">
                                            <TextBlock x:Name="AccountQuickLaunchEmptyText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                       Text="No Manager accounts saved yet."
                                                       IsVisible="False"
                                                       Margin="8" />
                                            <StackPanel x:Name="AccountQuickLaunchRows"
                                                        Spacing="2" />
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button x:Name="AccountQuickLaunchLaunchButton"
                                            Grid.Column="0"
                                            Height="34"
                                            Classes="skua-button"
                                            HorizontalContentAlignment="Center"
                                            IsEnabled="False"
                                            Click="AccountQuickLaunchLaunch_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <materialIcons:MaterialIcon Kind="LoginVariant"
                                                                        Width="15"
                                                                        Height="15"
                                                                        Foreground="{DynamicResource SkuaTextBrush}" />
                                            <TextBlock x:Name="AccountQuickLaunchLaunchText"
                                                       Text="Launch Selected"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccountQuickLaunchNewWindowButton"
                                            Grid.Column="1"
                                            Height="34"
                                            Classes="skua-button"
                                            HorizontalContentAlignment="Center"
                                            IsEnabled="False"
                                            Content="New Window"
                                            ToolTip.Tip="Launch selected accounts in a separate VibeSkua window"
                                            Click="AccountQuickLaunchNewWindow_Click" />
                                </Grid>
                                <TextBlock Text="Ctrl+Shift+L · Space select · Enter launch · Esc close"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Quick Multi-Client Actions (Army Control & Grid View) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" Spacing="6" VerticalAlignment="Center">
                    <!-- Army Control Button -->
                    <Border x:Name="GlobeBorder"
                            Cursor="Hand"
                            Height="28"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            CornerRadius="6"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            PointerPressed="GlobeBorder_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Earth" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Army Control" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem x:Name="MenuStartScripts" Header="Start All Scripts" Click="MenuItem_StartAllScripts_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuStopScripts" Header="Stop All Scripts" Click="MenuItem_StopAllScripts_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaDangerBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuLoadScripts" Header="Load Script to All" Click="MenuItem_LoadScriptAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Army Scheduler" Click="MenuItem_ArmyScheduler_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="CalendarClockOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="MenuStartAutoAttack" Header="Start Auto-Attack for All" Click="MenuItem_StartAutoAttackAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="SwordCross" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuStopAutoAttack" Header="Stop Auto-Attack for All" Click="MenuItem_StopAutoAttackAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaDangerBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Login All Clients" Click="MenuItem_LoginAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LoginVariant" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Logout All Clients" Click="MenuItem_LogoutAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LogoutVariant" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Map Travel..." Click="MenuItem_MapTravel_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="MapMarkerOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Jump All to Player..." Click="MenuItem_JumpPlayer_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="AccountArrowRightOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Jump All to House" Click="MenuItem_JumpHouse_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="HomeOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Change Server for All..." Click="MenuItem_ChangeServerAll_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ServerNetwork" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Accept Quest to All..." Click="MenuItem_AcceptQuest_Click">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileDocumentEditOutline" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="MiscOptionsMenu" Header="Misc Options">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="Lag Killer" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding LagKiller, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="FlashOutline" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Headless Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HeadlessMode, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="MonitorOff" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Hide Players" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding HidePlayers, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="AccountEyeOutline" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Disable FX" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding DisableFX, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="AutoFix" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Infinite Range" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding InfiniteRange, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="ArrowExpandAll" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Aggro Monsters" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding AggroMonsters, Mode=TwoWay}"
                                              ToolTip.Tip="Provoke every monster in the room. Can keep you in combat and block quest turn-ins.">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Target" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Streamer Mode" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding StreamerMode, Mode=TwoWay}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Broadcast" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuShowFps" Header="Show FPS" ToggleType="CheckBox" StaysOpenOnClick="True">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                    
                    <!-- Grid View Toggle Button -->
                    <Border x:Name="GridViewBorder"
                            Cursor="Hand"
                            Height="28"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            CornerRadius="6"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            PointerPressed="GridViewBorder_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon x:Name="GridViewIcon" Kind="ViewGridOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="GridViewText" Text="Grid View" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Grid Layout selector temporarily hidden; implementation retained for later.

                    <Border x:Name="GridLayoutBorder"
                            Cursor="Hand"
                            Height="28"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            CornerRadius="6"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            PointerPressed="GridLayoutBorder_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaTextBrush}" />
                            <TextBlock Text="Layout" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="11" Height="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />

                        </StackPanel>
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Auto (balanced)" Click="MenuItem_GridLayoutAuto_Click" />
                                <MenuItem Header="Side-by-side" Click="MenuItem_GridLayoutHorizontal_Click" />
                                <MenuItem Header="Stacked" Click="MenuItem_GridLayoutVertical_Click" />
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                    -->
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Game Instance Host Container -->
        <Grid Grid.Row="2" Background="{DynamicResource SkuaPageBrush}">
            <StackPanel x:Name="LoadingIndicator" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                <TextBlock Text="Loading Game Instance..." Foreground="{DynamicResource SkuaTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Please wait while the game client initializes" Foreground="{DynamicResource SkuaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
            <Border x:Name="HostContainer" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
