<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Runtime"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.JunkItemsView"
             x:DataType="vms:JunkItemsViewModel"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="700">
  <UserControl.Styles>
    <!-- Rows select through their check box, so the row shows the item's IsSelected, not ListBox selection -->
    <Style Selector="Border.junk-row">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.junk-row">
      <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    </Style>
    <Style Selector="Border.junk-row.selected">
      <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.junk-row.selected">
      <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <!-- Search and refresh -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0"
               Watermark="Search by ID or name"
               Text="{Binding SearchText, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1"
              Classes="skua-button"
              Width="32"
              Padding="0"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="Refresh inventory and bank">
        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
      </Button>
    </Grid>

    <!-- Item filters -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
      <ComboBox Grid.Column="0" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Filter by item category" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding AcFilterOptions}" SelectedItem="{Binding AcFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Filter AC items or non-AC items" />
    </Grid>

    <!-- Selection bar: select all / clear, and what to do with the selection -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="9,0,0,0">
      <CheckBox Grid.Column="0"
                IsChecked="{Binding SelectionState, Mode=TwoWay}"
                Content="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                FontWeight="SemiBold"
                ToolTip.Tip="Select or clear all shown items" />
      <Button Grid.Column="2" Classes="skua-button small w112" Command="{Binding MarkAsJunkCommand}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="TagOutline" Width="14" Height="14" />
          <TextBlock Text="Mark as junk" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="skua-button small w84" Content="Unmark" Command="{Binding UnmarkAsJunkCommand}" />
    </Grid>

    <!-- Inventory and bank items -->
    <ListBox Grid.Row="3"
             Classes="card-list"
             ItemsSource="{Binding FilteredItems}"
             Padding="4">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vms:JunkItemEntry">
          <Border Classes="junk-row" Classes.selected="{Binding IsSelected}" Margin="0,0,0,2">
            <Grid ColumnDefinitions="Auto,52,*,Auto,Auto,Auto" ColumnSpacing="8">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ID}"
                         FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                         FontSize="11"
                         Foreground="{DynamicResource SkuaMutedTextBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding Category}" />
              <Border Grid.Column="3" Classes="chip" IsVisible="{Binding IsAc}">
                <TextBlock Text="AC" />
              </Border>
              <TextBlock Grid.Column="4"
                         Text="{Binding QuantityDisplay}"
                         FontSize="11"
                         Foreground="{DynamicResource SkuaMutedTextBrush}"
                         VerticalAlignment="Center" />
              <Border Grid.Column="5" Classes="chip danger" IsVisible="{Binding IsJunk}">
                <TextBlock Text="Junk" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Selling -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <CheckBox Grid.Column="0"
                Content="Skip sell warning"
                IsChecked="{Binding SkipSellWarning, Mode=TwoWay}"
                VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="skua-button w112" Content="Unmark all" Command="{Binding UnmarkAllJunkCommand}" />
      <Button Grid.Column="3" Classes="skua-button skua-danger-soft w112" Command="{Binding SellSelectedCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="CurrencyUsd" Width="15" Height="15" />
          <TextBlock Text="Sell selected" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="skua-button skua-danger w140" Command="{Binding SellAllJunkCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="15" Height="15" />
          <TextBlock Text="{Binding TotalJunk, StringFormat='Sell all junk ({0})'}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>
