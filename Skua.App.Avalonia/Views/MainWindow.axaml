<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Skua.App.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
        xmlns:sharedShell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:core="clr-namespace:Skua.Core.Interfaces.ViewModels;assembly=Skua.Core.Interfaces"
        x:Class="Skua.App.Avalonia.Views.MainWindow"
        Classes="skua"

        mc:Ignorable="d" d:DesignWidth="948" d:DesignHeight="600"
        Width="948" Height="600"
        MinWidth="0" MinHeight="0"
        WindowStartupLocation="Manual"

        Title="{Binding Title}"
        Icon="avares://Skua.Shared.Avalonia/Assets/SkuaClientIcon.ico"

        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        >

  <!-- This root class enables shared shell selectors from Theme.axaml (Window.skua ...). -->
  <Grid RowDefinitions="Auto,*">

    <sharedShell:WindowTitleBar Grid.Row="0"
                                x:Name="TitleBar"
                                TitleText="{Binding Title}" />

    <Grid Grid.Row="1"
      RowDefinitions="Auto,*">

      <!-- Top Navigation & Quick-Tools Bar -->
      <Border x:Name="TopNavBorder"
              Grid.Row="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="0,0,0,1"
              Height="34"
              Padding="4,0">
        <DockPanel x:Name="MainMenuBar"
                   DataContext="{Binding MainMenu}"
                   LastChildFill="True">
          <!-- Right-side Quick Access Tools (Auto, Jump, + Bot Windows) -->
          <StackPanel DockPanel.Dock="Right"
                      Margin="0,0,4,0"
                      Orientation="Horizontal"
                      Spacing="4"
                      VerticalAlignment="Center">
            <!-- Auto Combat & Hunting Toggle -->
            <ToggleButton x:Name="AutoToggle"
                          Classes="top-nav-item"
                          ToolTip.Tip="Automated Combat &amp; Hunting Controls">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="RobotOutline"
                                            Width="13" Height="13"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SkuaTextBrush}" />
                <TextBlock Text="Auto"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Border Width="6" Height="6"
                        CornerRadius="3"
                        Background="#10B981"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding AutoViewModel.Auto.IsRunning}" />
              </StackPanel>
            </ToggleButton>
            <Popup Placement="Bottom"
                   IsLightDismissEnabled="True"
                   IsOpen="{Binding IsChecked, ElementName=AutoToggle, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=AutoToggle}">
              <sharedShell:TopbarPopupPanel>
                <uc:AutoUserControl DataContext="{Binding AutoViewModel}" />
              </sharedShell:TopbarPopupPanel>
            </Popup>

            <!-- Jump Toggle -->
            <ToggleButton x:Name="JumpToggle"
                          Classes="top-nav-item"
                          ToolTip.Tip="Map &amp; Cell Fast Jump Controls">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="RunFast"
                                            Width="13" Height="13"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SkuaTextBrush}" />
                <TextBlock Text="Jump"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Popup Placement="Bottom"
                   IsLightDismissEnabled="True"
                   IsOpen="{Binding IsChecked, ElementName=JumpToggle, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=JumpToggle}">
              <sharedShell:TopbarPopupPanel>
                <uc:JumpUserControl DataContext="{Binding JumpViewModel}" />
              </sharedShell:TopbarPopupPanel>
            </Popup>

            <Border Width="1" Height="16" Background="{DynamicResource SkuaBorderBrush}" Margin="2,0" VerticalAlignment="Center" />

            <!-- Show Bot Window / Tools Launcher -->
            <Button Classes="top-nav-item"
                    Width="28" Height="28"
                    Padding="0"
                    Command="{Binding ShowBotWindowCommand}"
                    ToolTip.Tip="Show All Bot Windows &amp; Tools">
              <materialIcons:MaterialIcon Kind="Plus"
                                          Width="15" Height="15"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SkuaTextBrush}" />
            </Button>
          </StackPanel>

          <!-- Top Main Menu Bar (Scripts, Options, Tools & Helpers, Combat, Bank, Diagnostics, Plugins) -->
          <Menu x:Name="MainMenuControl"
                Classes="top-toolbar"
                VerticalAlignment="Center">
          </Menu>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1"
            Background="{DynamicResource SkuaPageBrush}">
        <controls:WinFormsFlashHost x:Name="FlashHost" IsVisible="False" />
        <ProgressBar x:Name="LoadingBar"
                     Width="150"
                     Height="8"
                     IsIndeterminate="True"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        <Grid x:Name="HeadlessOverlay" Background="{DynamicResource SkuaPageBrush}" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <materialIcons:MaterialIcon Kind="MonitorOff" Width="36" Height="36" Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource SkuaTextBrush}" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Headless Mode Active" />
                <TextBlock Foreground="{DynamicResource SkuaMutedTextBrush}" HorizontalAlignment="Center" FontSize="12" Text="Viewport suspended to minimize CPU and GPU usage" />
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>

  </Grid>

</Window>




