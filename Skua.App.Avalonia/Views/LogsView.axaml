<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.LogsView">

    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
        <!-- Log tabs; the actions apply to the open tab -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <ListBox Grid.Column="0"
                     Classes="top-tabs-client"
                     ItemsSource="{Binding LogTabs}"
                     SelectedItem="{Binding SelectedTab}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Classes="top-tabs-label" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="skua-button small w84" Click="CopyButton_Click" ToolTip.Tip="Copy the selected lines (or all)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="skua-button small w84" Click="DeselectButton_Click" ToolTip.Tip="Clear the selected lines">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="SelectionRemove" Width="14" Height="14" />
                    <TextBlock Text="Deselect" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="skua-button small w84" Command="{Binding SelectedTab.SaveLogCommand}" ToolTip.Tip="Save this log to a file">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="skua-button small skua-danger-soft w84" Command="{Binding SelectedTab.ClearLogCommand}" ToolTip.Tip="Clear this log">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="TabContent" Content="{Binding SelectedTab}" />
    </Grid>
</UserControl>
