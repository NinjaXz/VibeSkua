<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             x:Class="Skua.App.Avalonia.Views.NotificationCenterView"
             x:DataType="vms:NotificationCenterViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440">
  <UserControl.Styles>
    <!-- Kind colours: one icon per entry, tinted by kind (activity stays muted) -->
    <Style Selector="materialIcons|MaterialIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.kind.item">
      <Setter Property="Foreground" Value="{DynamicResource SkuaSuccessBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.kind.warning">
      <Setter Property="Foreground" Value="{DynamicResource SkuaWarningBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.kind.error">
      <Setter Property="Foreground" Value="{DynamicResource SkuaDangerBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.kind.map">
      <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
    <!-- Filter chips with counts -->
    <ListBox Grid.Row="0" Classes="chips" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vms:NotificationFilter">
          <!-- Text and count only, so all six fit on one row; the rows carry the kind icons -->
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Count}" Opacity="0.7" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="1" Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" CornerRadius="8">
      <Panel>
        <!-- Click to select lines (like Logs); Ctrl+C or Copy copies them -->
        <ListBox x:Name="FeedList" ItemsSource="{Binding FilteredNotifications}" Background="Transparent"
                 BorderThickness="0" Padding="4" SelectionMode="Multiple"
                 KeyDown="FeedList_KeyDown" SelectionChanged="FeedList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vms:NotificationEntry">
              <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,3" ColumnSpacing="10">
                <materialIcons:MaterialIcon Grid.Column="0" Classes="kind"
                                            Classes.item="{Binding IsItem}"
                                            Classes.warning="{Binding IsWarning}"
                                            Classes.error="{Binding IsError}"
                                            Classes.map="{Binding IsSystem}"
                                            Kind="{Binding Icon}" Width="15" Height="15"
                                            VerticalAlignment="Top" Margin="0,1,0,0"
                                            ToolTip.Tip="{Binding KindName}" />
                <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="11"
                           FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" MaxWidth="300">
          <materialIcons:MaterialIcon Kind="BellOutline" Width="28" Height="28" Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <TextBlock Text="{Binding EmptyText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Footer: count and selection on the left, the Logs window's actions on the right -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" x:Name="CountText" Text="0 events" FontSize="11" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SkuaMutedTextBrush}" />
      <Button Grid.Column="1" Classes="skua-button small w84" Click="CopyButton_Click" ToolTip.Tip="Copy the selected events (or all shown)">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
          <TextBlock Text="Copy" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="skua-button small w84" Click="DeselectButton_Click" ToolTip.Tip="Clear the selected events">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="SelectionRemove" Width="14" Height="14" />
          <TextBlock Text="Deselect" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="skua-button small w84" Command="{Binding SaveCommand}" ToolTip.Tip="Save the shown events to a file">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" />
          <TextBlock Text="Save" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="skua-button small skua-danger-soft w84" Command="{Binding ClearCommand}" ToolTip.Tip="Clear every event">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
          <TextBlock Text="Clear" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>
