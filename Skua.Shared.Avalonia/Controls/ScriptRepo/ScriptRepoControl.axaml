<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:scriptRepo="clr-namespace:Skua.Shared.Avalonia.ViewModels.ScriptRepo;assembly=Skua.Shared.Avalonia"
             x:DataType="scriptRepo:ScriptRepoViewModel"
             x:Name="Root"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.Shared.Avalonia.Controls.ScriptRepo.ScriptRepoControl">

    <!-- Search Scripts (client) / Script Repo (Manager): search row, one list (each row: name, full description, path
         with size and date, all tags; Start / Load / Queue / more always on the right), and a footer with the repo
         counts and the bulk actions. The Manager hides Start. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">

        <!-- 1. Search, what it looks in, category, order (name or date) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding !IsBusy}">
            <TextBox Grid.Column="0" Watermark="Search scripts by name, path or tag" Text="{Binding SearchText, Mode=TwoWay}">
                <TextBox.InnerLeftContent>
                    <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Classes="icon icon-muted" Width="22" Height="22" Margin="0,0,6,0"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchText.Length}"
                            ToolTip.Tip="Clear search">
                        <materialIcons:MaterialIcon Kind="CloseCircle" Width="14" Height="14" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
            <ComboBox Grid.Column="1" Width="120" ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope, Mode=TwoWay}"
                      ToolTip.Tip="Search in: all, name, tags, description or file path" />
            <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterBy, Mode=TwoWay}"
                      ToolTip.Tip="Category" />
            <ToggleButton Grid.Column="3" Classes="app-toggle" Width="32" Padding="0" HorizontalContentAlignment="Center"
                          IsChecked="{Binding IsSortReversed, Mode=OneWay}"
                          Command="{Binding CycleSortCommand}"
                          ToolTip.Tip="{Binding SortDirectionText, StringFormat='Order: {0}'}">
                <materialIcons:MaterialIcon Kind="{Binding SortDirectionIcon}" Width="16" Height="16" />
            </ToggleButton>
        </Grid>

        <!-- 2. The scripts -->
        <Grid Grid.Row="1">
            <Border Classes="option-list">
                <Grid>
                    <ListBox x:Name="ScriptList"
                             ItemsSource="{Binding FilteredScripts}"
                             SelectedItem="{Binding SelectedItem}"
                             IsEnabled="{Binding !IsBusy}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             Margin="0,0,0,-1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <!-- Flat rows with a line between them, like the options lists -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding TogglePinCommand}"
                                          CommandParameter="{Binding SelectedItem}"
                                          Header="Pin / Unpin Script"
                                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Pin" Width="14" Height="14" Foreground="{DynamicResource SkuaWarningBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding DownloadCommand}"
                                          Header="Download Script"
                                          IsEnabled="{Binding SelectedItem.Downloaded, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding DeleteCommand}"
                                          Header="Delete Script"
                                          IsEnabled="{Binding SelectedItem.Downloaded, FallbackValue=False}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaDangerBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenScriptCommand}"
                                          Header="Open in VS Code"
                                          IsEnabled="{Binding SelectedItem.Downloaded, FallbackValue=False}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="MicrosoftVisualStudioCode" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="scriptRepo:ScriptInfoViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,5,0,0"
                                             ToolTip.Tip="{Binding StatusText}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <materialIcons:MaterialIcon Kind="Pin" Width="13" Height="13" Foreground="{DynamicResource SkuaGoldBrush}"
                                                                        IsVisible="{Binding IsPinned}" VerticalAlignment="Center" />
                                            <Border Classes="chip warning" IsVisible="{Binding Outdated}">
                                                <TextBlock Text="Update" />
                                            </Border>
                                            <Border Classes="chip accent" IsVisible="{Binding IsCustom}">
                                                <TextBlock Text="Local" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info.Description}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        <!-- Path (never trimmed; wraps at folders), then size and date -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="0,2,0,0">
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="12" Height="12" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                        Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            <TextBlock Grid.Column="1" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                       ToolTip.Tip="{Binding DisplayPath}">
                                                <Run Text="{Binding WrappablePath}" FontFamily="JetBrains Mono,Consolas,Courier New,monospace" />
                                                <Run Text="{Binding ListMeta}" />
                                            </TextBlock>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding InfoTags}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="chip" Height="18">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Always there, so nothing moves on hover. 90x30: a little larger than the small buttons, still clear of the text -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="skua-button skua-primary w90" Height="30" MinHeight="30"
                                                IsVisible="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).ShowStartButton}"
                                                Command="{Binding StartScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Start this script now">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" />
                                                <TextBlock Text="Start" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="skua-button w90" Height="30" MinHeight="30"
                                                Command="{Binding LoadScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Load into the Script Loader">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                                <TextBlock Text="Load" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="skua-button w90" Height="30" MinHeight="30"
                                                Command="{Binding QueueScriptCommand}" CommandParameter="{Binding .}"
                                                IsEnabled="{Binding Downloaded}" ToolTip.Tip="Add to the Scheduler queue">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="15" Height="15" />
                                                <TextBlock Text="Queue" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="skua-button" Width="30" Height="30" MinHeight="30" Padding="0" HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Pin, download, update, VS Code, delete">
                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="{Binding PinToolTip}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding .}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="{Binding PinIcon}" Width="14" Height="14" Foreground="{Binding PinColor}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <!-- Download when it isn't local yet; Update re-downloads a local repo script, newer or not
                                                         (greyed out for custom scripts, which aren't in the repo) -->
                                                    <MenuItem Header="Download" IsVisible="{Binding !Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding .}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Update" IsVisible="{Binding Downloaded}" IsEnabled="{Binding CanUpdate}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding .}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="Update" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Open in VS Code" IsEnabled="{Binding Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).OpenScriptCommand}" CommandParameter="{Binding .}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="MicrosoftVisualStudioCode" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete" IsEnabled="{Binding Downloaded}"
                                                              Command="{Binding #Root.((scriptRepo:ScriptRepoViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding .}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="{DynamicResource SkuaDangerBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Still loading the list -->
                    <Panel IsVisible="{Binding IsLoadingScripts}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding !FilteredScripts.Count}">
                            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="40" Height="40" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            <TextBlock Text="Loading scripts..." FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Height="4" Width="200" HorizontalAlignment="Center" />
                            <TextBlock Text="Getting the script list, this can take a few seconds." FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Panel>

                    <!-- Nothing matches -->
                    <Panel IsVisible="{Binding !IsLoadingScripts}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding !FilteredScripts.Count}">
                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="40" Height="40" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            <TextBlock Text="No scripts found" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing matches the search or category." FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Classes="skua-button w140" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FilterRemoveOutline" Width="15" Height="15" />
                                    <TextBlock Text="Clear search" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- Busy: blocks the list until the task ends or is cancelled -->
            <Border Background="#B0000000" CornerRadius="8" IsVisible="{Binding IsBusy}">
                <Border Background="{DynamicResource SkuaSurfaceBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="320"
                        MaxWidth="450">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Width="240" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressReportMessage, FallbackValue='Processing...'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Classes="skua-button skua-danger w112" HorizontalAlignment="Center" Command="{Binding CancelTaskCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Cancel" Width="14" Height="14" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- 3. Repo counts and bulk actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" IsEnabled="{Binding !IsBusy}">
            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{Binding ScriptQuantity, StringFormat='{}{0:N0} scripts'}" />
                <Run Text="·" />
                <Run Text="{Binding DownloadedQuantity, StringFormat='{}{0:N0} local'}" />
                <Run Text="·" />
                <Run Text="{Binding PinnedQuantity, StringFormat='{}{0:N0} pinned'}" />
                <Run Text="·" />
                <Run Text="{Binding OutdatedQuantity, StringFormat='{}{0:N0} updates'}" Foreground="{DynamicResource SkuaWarningBrush}" />
            </TextBlock>
            <Button Grid.Column="1" Classes="skua-button small w112" Command="{Binding UpdateAllCommand}"
                    ToolTip.Tip="Download every script that has an update">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="Update" Width="14" Height="14" />
                    <TextBlock Text="Update all" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="skua-button small w112" Command="{Binding DownloadAllCommand}"
                    ToolTip.Tip="Download every script you don't have, and every update">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="DownloadMultiple" Width="14" Height="14" />
                    <TextBlock Text="Download all" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    Command="{Binding RefreshScriptsCommand}" ToolTip.Tip="Fetch the latest script list from the repo">
                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="4" Classes="skua-button small" Width="26" Padding="0" HorizontalContentAlignment="Center"
                    ToolTip.Tip="More">
                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="Update dates from Git" Command="{Binding UpdateDatesCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="CalendarSyncOutline" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Set custom scripts folder..." Command="{Binding AddCustomFolderCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FolderPlus" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Clear custom scripts folder" Command="{Binding ClearCustomFolderCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FolderRemove" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Load a script file..." Command="{Binding LoadLocalScriptCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FileDocumentPlus" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Open the Scripts folder in VS Code" Command="{Binding OpenScriptFolderCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="MicrosoftVisualStudioCode" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
