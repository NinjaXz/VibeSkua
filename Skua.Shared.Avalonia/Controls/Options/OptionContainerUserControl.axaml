<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.Shared.Avalonia.ViewModels.Options"
             xmlns:controls="clr-namespace:Skua.Shared.Avalonia.Controls.Options"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Shared.Avalonia.Controls.Options.OptionContainerUserControl"
             x:DataType="vms:OptionContainerViewModel"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="520">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <!-- Notice: saved enum choices that were reset because the script no longer has them -->
    <Border Grid.Row="0"
            Margin="0,0,0,10"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaAccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            IsVisible="{Binding ResetNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*">
        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" VerticalAlignment="Top"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource SkuaAccentBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ResetNotice}"
                   FontSize="12"
                   Foreground="{DynamicResource SkuaTextBrush}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Options List Panel -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False">
        <ItemsControl ItemsSource="{Binding GroupedOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vms:OptionCategoryGroup">
              <Expander IsExpanded="True"
                        Margin="0,0,0,8"
                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="FolderCogOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                    <TextBlock Text="{Binding Category}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource SkuaTextBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vms:OptionContainerItemViewModel">
                      <Border Margin="0,2"
                              Padding="8,6"
                              CornerRadius="6"
                              Background="{DynamicResource SkuaSurfaceBrush}"
                              BorderBrush="{DynamicResource SkuaBorderBrush}"
                              BorderThickness="1"
                              PointerPressed="OnOptionPointerPressed">
                        <Grid ColumnDefinitions="*,Auto">
                          <!-- Option Display Name -->
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Option.DisplayName, FallbackValue={Binding Option.Name}}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource SkuaTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Option.Description}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Option.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>

                          <!-- Value Editor Control -->
                          <controls:OptionValueEditorControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Bottom Selected Option Info Card -->
    <Border Grid.Row="2"
            Margin="0,10,0,0"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding SelectedOption.Option.DisplayName, FallbackValue='Option Info'}"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="{DynamicResource SkuaTextBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SelectedOption.Option.DefaultValue, StringFormat='Default: {0}'}"
                     FontSize="11"
                     Foreground="{DynamicResource SkuaMutedTextBrush}"
                     IsVisible="{Binding SelectedOption.Option.DefaultValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <TextBlock Text="{Binding SelectedOption.Option.Description, FallbackValue='Select an option to view its description.'}"
                   FontSize="12"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
