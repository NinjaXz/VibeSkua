<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Rows: hover = NavHover; selected = accent tint + accent border (the same rule as cards, tabs and toggles) -->
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="6" />
        <!-- On the item, not the presenter: the template binds the presenter border to these -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <!-- Card lists: ListBox Classes="card-list" whose item template root is Border Classes="list-card".
         The card itself shows hover/selection; the ListBoxItem around it stays transparent. -->
    <Style Selector="ListBox.card-list ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.card-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.card-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>
    <Style Selector="Border.list-card.alt">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover Border.list-card">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="ListBox.embedded">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.gap-bottom-8">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Page tabs (Manager navigation, Logs tabs): boxed, one minimum width per strip so short labels line up.
         Off = neutral box with muted text; selected = accent tint + accent border, white semibold text. -->
    <Style Selector="ListBox.top-tabs, ListBox.top-tabs-client">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- The strip has no box of its own; the global 8px radius would clip the first tab's corners -->
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.top-tabs ListBoxItem,ListBox.top-tabs-client ListBoxItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.top-tabs-client ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.top-tabs-client ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.top-tabs-client ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.top-tabs-client ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.top-tabs ListBoxItem:selected TextBlock, ListBox.top-tabs-client ListBoxItem:selected TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Segmented control: a 32px track with equal options (bind SelectedIndex). Selected = tint + accent border. -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <!-- Chip row: wrapping pills (section filters in the options windows). Selected = tint + accent border. -->
    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
</Styles>
