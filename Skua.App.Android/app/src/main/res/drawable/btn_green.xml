<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_green_bg_pressed" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_green_bg" />
            <stroke android:width="1.5dp" android:color="@color/btn_green_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

