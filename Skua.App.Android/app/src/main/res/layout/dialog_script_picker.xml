<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="18dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvScriptPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCRIPT PICKER"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScriptPickerClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_box"
            android:text="X"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/editScriptPickerSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/edittext_bg"
        android:hint="Search scripts by name or category..."
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:layout_marginBottom="10dp" />

    <!-- Category Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/layoutPickerCategoryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChipAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_account_pill"
                android:text="ALL"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnChipArmy"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_box"
                android:text="ARMY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnChipBots"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_box"
                android:text="BOTS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnChipStory"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_box"
                android:text="STORY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnChipFarm"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_box"
                android:text="FARM"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnChipRep"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_box"
                android:text="REP"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty Notice -->
    <TextView
        android:id="@+id/tvEmptyScriptPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No scripts found matching search."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Scripts RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerScriptPicker"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scrollbars="vertical"
        android:overScrollMode="never" />

</LinearLayout>
