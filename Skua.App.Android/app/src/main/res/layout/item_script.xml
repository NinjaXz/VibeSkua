<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Script Name -->
        <TextView
            android:id="@+id/scriptName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="ScriptName"
            android:ellipsize="end"
            android:maxLines="2" />

        <!-- Badges Row: Category & Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/scriptCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="Category"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/scriptStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:text="Downloaded" />

            <TextView
                android:id="@+id/scriptDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="6dp"
                android:text="2024-01-01"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Path and Size -->
        <TextView
            android:id="@+id/scriptPathAndSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginTop="3dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="Path | 0 KB" />

        <!-- Description -->
        <TextView
            android:id="@+id/scriptDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Tags -->
        <TextView
            android:id="@+id/scriptTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRunScript"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:background="@drawable/btn_green"
        android:text="RUN"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginStart="10dp" />

</LinearLayout>
